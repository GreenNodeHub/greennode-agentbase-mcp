  "definitions": {
    "handler.ErrorBody": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/handler.ErrorDetail"
        }
      }
    },
    "handler.ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
    "handler.UpdateQuotaRequest": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "example": 10
        }
      }
    },
    "model.AdminCleanResult": {
      "type": "object",
      "properties": {
        "cacheInvalidated": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imagesDeleted": {
          "type": "integer"
        },
        "repositoryDeleted": {
          "type": "boolean"
        },
        "robotAccountsDeleted": {
          "type": "integer"
        },
        "userId": {
          "type": "integer"
        }
      }
    },
    "model.ArtifactPage": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/model.ArtifactResponse"
          }
        },
        "page": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "totalItem": {
          "type": "integer"
        },
        "totalPage": {
          "type": "integer"
        }
      }
    },
    "model.ArtifactResponse": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "pullTime": {
          "type": "string"
        },
        "pushTime": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/model.TagResponse"
          }
        },
        "type": {
          "type": "string"
        }
      }
    },
    "model.ImagePage": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/model.ImageResponse"
          }
        },
        "page": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "totalItem": {
          "type": "integer"
        },
        "totalPage": {
          "type": "integer"
        }
      }
    },
    "model.ImageResponse": {
      "type": "object",
      "properties": {
        "artifactCount": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "pullCount": {
          "type": "integer"
        },
        "updateTime": {
          "type": "string"
        }
      }
    },
    "model.RepositoryResponse": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "imageCount": {
          "type": "integer",
          "example": 5
        },
        "name": {
          "type": "string",
          "example": "my-repo"
        },
        "quotaLimit": {
          "type": "integer",
          "example": 21474836480
        },
        "quotaUsed": {
          "type": "integer",
          "example": 311926433
        },
        "registryUrl": {
          "type": "string",
          "example": "vcr.vngcloud.vn"
        }
      }
    },
    "model.TagResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pullTime": {
          "type": "string"
        },
        "pushTime": {
          "type": "string"
        }
      }
    },
    "service.RegistryCredentialInfo": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    }
  },
  "securityDefinitions": {
    "IAMAccessToken": {
      "description": "IAM access token. Enter \"Bearer {token}\"",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}