        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Admin"
        ],
        "summary": "Update repository quota for a user",
        "parameters": [
          {
            "type": "integer",
            "description": "User ID",
            "name": "userId",
            "in": "path",
            "required": true
          },
          {
            "description": "Quota size in GB",
            "name": "body",
            "in": "body",
            "required": true,
