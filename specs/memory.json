        "operationId": "listLongTermMemoryStrategies",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LongTermMemoryStrategyEntity"
                  }
                }
              }
            }
          }
        }
      }
    },
