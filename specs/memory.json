{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentBase Memory API",
    "description": "Managed long-term memory service for AI agents. It captures the raw events of an agent's interactions and distills them into durable, semantically searchable memory records, so your agents can recall context across sessions without you running your own vector store or extraction pipeline.\n\n## Authentication\nEvery request must carry a VNG Cloud IAM OAuth2 access token in the `Authorization` header as `Bearer <access_token>`. Use the **Authorize** button above to set it for \"Try it out\" calls. The gateway validates the token and enforces fine-grained IAM permissions on the **Agent Memory** resource.\n\n## Core concepts\n- **Memory**: a top-level store you own. It holds the events and memory records for one agent application, and defines how long raw events are retained (`eventExpiryDuration`, in days) and which long-term memory strategies apply.\n- **Long-term memory strategy (LTMS)**: the recipe for turning raw interactions into long-term memory records. It sets the extraction `type`, an optional custom fact-extraction prompt, a `namespaceTemplate` that decides where records land, and whether records are generated automatically.\n- **Event**: an immutable raw interaction (a payload plus timestamp) appended under an actor and session. Events form the short-term, episodic history and expire after the memory's `eventExpiryDuration`.\n- **Actor / Session**: events are organized by **actor** (who the interaction is with, e.g. an end user) and **session** (a single conversation with that actor).\n- **Memory record**: a distilled long-term fact extracted from events or supplied content. Records live in a **namespace** and are retrievable by semantic search.\n- **Namespace**: a logical partition for memory records, resolved from a strategy's `namespaceTemplate` (which may contain placeholders such as `{actorId}`).\n\nRecords can be produced automatically as events accumulate, generated on demand from a session or from content you post, or inserted directly.",
    "contact": {
      "name": "GreenNode AI Platform",
      "url": "https://aiplatform.console.greennode.ai/memory"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://agentbase.api.vngcloud.vn/memory"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Memories",
      "description": "Manage memory stores and everything they contain: the raw events of an agent's interactions (organized by actor and session) and the distilled, semantically searchable long-term memory records generated from them."
    }
  ],
  "paths": {
    "/memories": {
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "List memories",
        "description": "Returns a paginated list of the memory stores owned by the caller. `page` is 1-based.",
        "operationId": "list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponseMemoryEntity"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Create a memory",
        "description": "Creates a new memory store for the caller, along with the long-term memory strategies supplied in the request. `eventExpiryDuration` (in days) sets how long raw events are retained.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryEntity"
                }
              }
            }
          }
        }
      }
    },
    "/memories/{id}/memory-records:search": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Search memory records",
        "description": "Semantically searches the memory records in the given `namespace` for those most relevant to the query, returning up to `limit` results above the `scoreThreshold`.",
        "operationId": "searchMemoryRecords",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "namespace",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryRecordSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemoryRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/memories/{id}/memory-records:insert-directly": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Insert memory records directly",
        "description": "Writes the supplied memory records into the given `namespace` verbatim, bypassing the extraction pipeline. Use this to seed or import records you already have.",
        "operationId": "insertMemoryRecordsDirectly",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "namespace",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryRecordInsertDirectlyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/memories/{id}/memory-records:generate-from-session": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Generate memory records from a session",
        "description": "Runs the given long-term memory strategy over the stored events of an actor's session to extract and store memory records on demand.",
        "operationId": "generateMemoryRecordsFromSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longTermMemoryStrategyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/memories/{id}/memory-records:generate-from-content": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Generate memory records from content",
        "description": "Runs the given long-term memory strategy over the chat messages in the request body to extract and store memory records, without persisting the messages as events. `actorId` and `sessionId` are optional and only used to resolve the target namespace.",
        "operationId": "generateMemoryRecordsFromContent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longTermMemoryStrategyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryRecordGenerateFromContentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/memories/{id}/actors/{actorId}/sessions/{sessionId}/events": {
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "List events",
        "description": "Streams the events of an actor's session as JSON, most recent first, optionally bounded by the `fromTimestamp`/`toTimestamp` range. Page size is capped at 100.",
        "operationId": "listEvents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromTimestamp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "toTimestamp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Create an event",
        "description": "Appends a raw interaction event to the given actor's session. Events form the episodic history and are the source material for long-term memory record generation. If `eventTimestamp` is omitted, the server timestamps the event on receipt.",
        "operationId": "createEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/memories/{id}": {
