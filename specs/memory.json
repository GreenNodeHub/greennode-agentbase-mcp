  },
  "components": {
    "schemas": {
      "LongTermMemoryStrategy": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "customFactExtractionPrompt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 0
          },
          "namespaceTemplate": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[a-zA-Z0-9{}/._-]*$"
          },
          "enableAutomaticMemoryRecordGeneration": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "namespaceTemplate",
          "type"
        ]
      },
      "MemoryCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[a-zA-Z0-9._-]*$"
          },
          "description": {
            "type": "string"
          },
          "eventExpiryDuration": {
            "type": "integer",
            "format": "int32",
            "maximum": 365,
            "minimum": 1
          },
          "longTermMemoryStrategies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LongTermMemoryStrategy"
            }
          }
        },
        "required": [
          "description",
          "longTermMemoryStrategies",
          "name"
        ]
      },
      "MemoryEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "eventExpiryDuration": {
            "type": "integer",
            "format": "int32"
          },
          "portalUserId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MemoryRecordSearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "maximum": 200,
            "minimum": 5
          },
          "scoreThreshold": {
            "type": "number",
            "format": "float",
            "maximum": 1,
            "minimum": 0
          }
        },
        "required": [
          "query"
        ]
      },
      "MemoryRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "memory": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MemoryRecordInsertDirectlyRequest": {
        "type": "object",
        "properties": {
          "memoryRecords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "memoryRecords"
        ]
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "content",
          "role"
        ]
      },
      "MemoryRecordGenerateFromContentRequest": {
        "type": "object",
        "properties": {
          "chatMessages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1
          }
        },
        "required": [
          "chatMessages"
        ]
      },
      "EventCreateRequest": {
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/EventPayload"
          },
          "eventTimestamp": {
            "type": "string"
          }
        },
        "required": [
          "payload"
        ]
      },
      "EventPayload": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 0
          },
          "binaryData": {
            "type": "string",
            "maxLength": 10485760,
            "minLength": 0
          }
        },
        "required": [
          "type"
        ]
      },
      "ListResponseMemoryEntity": {
        "type": "object",
        "properties": {
          "listData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryEntity"
