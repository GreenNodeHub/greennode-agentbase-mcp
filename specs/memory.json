            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryEntity"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Memories"
        ],
